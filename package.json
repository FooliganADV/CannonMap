{
  "name": "cannonmap",
  "private": true,
  "version": "0.7.0",
  "scripts": {
    "vendor": "node scripts/vendor-dependencies.mjs",
    "validate:vendor": "node scripts/validate-vendor.mjs",
    "test": "node --test tests/*.test.mjs tests/architecture/*.test.mjs",
    "test:architecture": "node --test tests/architecture/*.test.mjs && node scripts/check-boundaries.mjs",
    "test:commitment": "node --test tests/commitment-engine.test.mjs",
    "test:routes": "node --test tests/route-family-engine.test.mjs",
    "test:confidence": "node --test tests/confidence-evolution.test.mjs",
    "validate:functions": "node scripts/validate-function-package.mjs",
    "test:browser": "playwright test",
    "test:security": "firebase emulators:exec --project demo-cannonmap --only database \"node --test tests/firebase/*.test.mjs\""
  },
  "devDependencies": {
    "firebase-tools": "14.12.0",
    "@playwright/test": "1.61.1"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "2.18.3",
    "firebase": "8.10.0",
    "leaflet": "1.9.4",
    "xlsx": "0.18.5"
  }
}
