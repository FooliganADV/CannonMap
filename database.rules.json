    },
    "commitmentInferenceHeads": {
      ".read": false,
      ".write": false
    },
    "commitmentDiagnostics": {
      ".read": false,
      ".write": false
    },
    "derivedIntelligence": {
      ".read": false,
      ".write": false
    },
    "ingestionQuota": {
      ".read": false,
      ".write": false
    }
  }
